# Neon Postgres
# Runtime URL should use the pooled Neon connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Migration URL should use the direct Neon connection string.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Vercel Cron sends this as an Authorization bearer token when set.
CRON_SECRET="replace-with-a-random-32-character-secret"

# Auth.js / Google sign-in
AUTH_SECRET="replace-with-another-random-32-character-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Optional: comma-separated allowlist. Leave empty to allow any Google account.
ALLOWED_EMAILS=""

# Global chat realtime and image uploads
ABLY_API_KEY="your-ably-api-key"
BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"
