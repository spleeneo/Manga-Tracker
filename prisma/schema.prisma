generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Manga {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  coverUrl    String?
  author      String?
  status      String?
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  chapters    Chapter[]
  sources     Source[]
  userManga   UserManga[]
  syncJobs    SyncJob[]
  contentRating       String?
  classificationSource String?
  classifiedAt        DateTime?
  tags                MangaTag[]
  childOverrides      ChildMangaOverride[]
}

model Source {
  id            String                      @id @default(uuid())
  mangaId       String
  sourceName    String
  sourceUrl     String
  externalId    String?
  lastCheckedAt DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  failureCount  Int                         @default(0)
  disabledUntil DateTime?
  manga         Manga                       @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  preferredBy   UserManga[]
  disabledBy    UserMangaDisabledSource[]
  rankedBy      UserMangaSourcePreference[]

  @@unique([mangaId, sourceUrl])
  @@index([sourceName])
}

model Chapter {
  id                String        @id @default(uuid())
  mangaId           String
  sourceId          String?
  providerChapterId String?
  source            Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  chapterNumber     Float
  title             String?
  url               String
  releaseDate       DateTime?
  isRead            Boolean       @default(false)
  readerStatus      String?
  readerCheckedAt   DateTime?
  readerPageCount   Int?
  readerError       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  manga             Manga         @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  userChapters      UserChapter[]

  @@unique([sourceId, providerChapterId])
  @@unique([sourceId, chapterNumber])
  @@index([mangaId, chapterNumber])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  library       UserManga[]
  chapters      UserChapter[]
  chatMessages  ChatMessage[]
  syncJobs      SyncJob[]
  parentLinks   ParentChildLink[] @relation("ParentLinks")
  childLink     ParentChildLink?  @relation("ChildLink")
  childPolicy   ChildPolicy?
  childOverrides ChildMangaOverride[] @relation("ChildOverrides")
  grantedOverrides ChildMangaOverride[] @relation("GrantedOverrides")
}

model ParentChildLink {
  id         String   @id @default(cuid())
  parentId   String
  childId    String?  @unique
  childEmail String   @unique
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  parent     User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child      User?    @relation("ChildLink", fields: [childId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

model ChildPolicy {
  id                  String   @id @default(cuid())
  childId             String   @unique
  enabled             Boolean  @default(true)
  allowedContentRatings String[] @default(["safe"])
  blockedTagNames     String[] @default(["gore", "sexual violence"])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  child               User     @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ContentTag {
  id        String     @id
  name      String
  group     String?
  manga     MangaTag[]

  @@index([name])
}

model MangaTag {
  mangaId String
  tagId   String
  manga   Manga      @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  tag     ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mangaId, tagId])
  @@index([tagId])
}

model ChildMangaOverride {
  id          String   @id @default(cuid())
  childId     String
  mangaId     String
  decision    String
  grantedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  child       User     @relation("ChildOverrides", fields: [childId], references: [id], onDelete: Cascade)
  manga       Manga    @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  grantedBy   User     @relation("GrantedOverrides", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([childId, mangaId])
  @@index([mangaId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model UserManga {
  id                    String                      @id @default(cuid())
  userId                String
  mangaId               String
  status                String                      @default("READING")
  preferredSourceId     String?
  lastReadChapterNumber Float?
  lastReadAt            DateTime?
  syncStatus            String                      @default("IDLE")
  syncStartedAt         DateTime?
  syncFinishedAt        DateTime?
  syncError             String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga                 Manga                       @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  preferredSource       Source?                     @relation(fields: [preferredSourceId], references: [id], onDelete: SetNull)
  disabledSources       UserMangaDisabledSource[]
  sourcePreferences     UserMangaSourcePreference[]

  @@unique([userId, mangaId])
  @@index([mangaId])
  @@index([userId, updatedAt])
}

model UserMangaDisabledSource {
  id          String    @id @default(cuid())
  userMangaId String
  sourceId    String
  createdAt   DateTime  @default(now())
  userManga   UserManga @relation(fields: [userMangaId], references: [id], onDelete: Cascade)
  source      Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([userMangaId, sourceId])
  @@index([sourceId])
}

model UserMangaSourcePreference {
  id          String    @id @default(cuid())
  userMangaId String
  sourceId    String
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userManga   UserManga @relation(fields: [userMangaId], references: [id], onDelete: Cascade)
  source      Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([userMangaId, sourceId])
  @@index([sourceId])
  @@index([userMangaId, position])
}

model UserChapter {
  id        String    @id @default(cuid())
  userId    String
  chapterId String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  body      String?
  imageUrl  String?
  imageName String?
  imageMime String?
  imageSize Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([userId])
}

model SyncJob {
  id         String    @id @default(cuid())
  type       String
  status     String    @default("QUEUED")
  userId     String?
  mangaId    String
  attempts   Int       @default(0)
  runAfter   DateTime  @default(now())
  lockedAt   DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga      Manga     @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([userId, status])
  @@index([mangaId, status])
}
